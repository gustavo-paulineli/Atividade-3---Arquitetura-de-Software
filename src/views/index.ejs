<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Gerenciador de Tarefas Acadêmicas</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="container">
    <header>
      <h1>Tarefas Acadêmicas</h1>
      <a href="/tarefas/nova" class="btn btn-primary">+ Nova Tarefa</a>
    </header>

    <nav class="filtros">
      <span>Filtrar por status:</span>
      <a href="/tarefas?status=todas" class="btn-filtro <%= filtro === 'todas' ? 'ativo' : '' %>">Todas</a>
      <a href="/tarefas?status=pendente" class="btn-filtro <%= filtro === 'pendente' ? 'ativo' : '' %>">Pendentes</a>
      <a href="/tarefas?status=concluida" class="btn-filtro <%= filtro === 'concluida' ? 'ativo' : '' %>">Concluídas</a>
    </nav>

    <% if (tarefas.length === 0) { %>
      <p class="vazio">Nenhuma tarefa encontrada para este filtro.</p>
    <% } else { %>
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Título</th>
            <th>Disciplina</th>
            <th>Status</th>
            <th>Ações</th>
          </tr>
        </thead>
        <tbody>
          <% tarefas.forEach(tarefa => { %>
            <tr class="<%= tarefa.status === 'concluida' ? 'linha-concluida' : '' %>">
              <td>#<%= tarefa.id %></td>
              <td><%= tarefa.titulo %></td>
              <td><%= tarefa.disciplina %></td>
              <td>
                <span class="badge <%= tarefa.status %>">
                  <%= tarefa.status === 'pendente' ? 'Pendente' : 'Concluída' %>
                </span>
              </td>
              <td class="acoes">
                <a href="/tarefas/<%= tarefa.id %>" class="btn btn-info">Detalhes</a>
                <a href="/tarefas/<%= tarefa.id %>/editar" class="btn btn-warning">Editar</a>
                
                <% if (tarefa.status === 'pendente') { %>
                  <form action="/tarefas/<%= tarefa.id %>/concluir" method="POST" style="display:inline;">
                    <button type="submit" class="btn btn-success">Concluir</button>
                  </form>
                <% } %>

                <form action="/tarefas/<%= tarefa.id %>/excluir" method="POST" style="display:inline;" onsubmit="return confirm('Tem certeza que deseja excluir esta tarefa?');">
                  <button type="submit" class="btn btn-danger">Excluir</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
</body>
</html>
